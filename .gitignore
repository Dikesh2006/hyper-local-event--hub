# Dependencies
node_modules/
/.pnp
.pnp.js

# Production build outputs
dist/
build/
.output/

# Environment files and credentials (CRITICAL: Never commit secrets to Git)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# Debug and runtime logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Editor and OS metadata
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env
