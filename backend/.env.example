# =========================================================
# Hyper Local Event Hub - Environment Variables & API Keys
# =========================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (MongoDB Local or MongoDB Atlas Cluster)
MONGO_URI=mongodb://127.0.0.1:27017/minnor

# Authentication & Security
# Generate a strong 256-bit key using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Payment Gateway Configuration (Optional - Razorpay Integration)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Cloud Storage Configuration (Optional - Cloudinary Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
